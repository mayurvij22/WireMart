rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only Yogesh's account may write. Replace with the UID shown in
    // Firebase console → Authentication → Users after creating his account.
    // (A plain "request.auth != null" check is NOT enough: anyone can create
    // an email/password account through the public API.)
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'eim4WftSgjTNQOmdrVAxj3MdTXf1';
    }

    function isValidProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'nameLower', 'keywords', 'price', 'category',
                               'features', 'imageUrl', 'morePhotos', 'description', 'inStock',
                               'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.nameLower is string
        && d.keywords is list && d.keywords.size() <= 400
        && (d.price is int || d.price is float) && d.price >= 0
        && d.category is string && d.category.size() > 0
        && d.features is list && d.features.size() <= 50
        && d.imageUrl is string && d.imageUrl.size() <= 250000
        && d.description is string && d.description.size() <= 5000
        && d.inStock is bool
        && (!('morePhotos' in d) || (d.morePhotos is int && d.morePhotos >= 0 && d.morePhotos <= 4));
    }

    // Up to 4 extra photos per product (the main photo is the product's imageUrl).
    function isValidPhotos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['images'])
        && d.images is list && d.images.size() <= 4;
    }

    function isValidCategory() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }

    match /productPhotos/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPhotos();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCategory();
      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
